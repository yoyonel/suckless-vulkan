#version 450 core
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D u_input_texture;
layout(set = 0, binding = 1, r11f_g11f_b10f) writeonly uniform image2D u_output_image;

layout(push_constant) uniform BloomDownsamplePushConstants {
    vec2 u_texel_size;  // 1.0 / input_texture_dimensions
    float u_threshold;  // Seuil minimal d'émission HDR (ex: 1.0)
    float u_knee;       // Largeur de transition douce Soft-Knee (ex: 0.5)
    int u_is_prefilter; // 1 = premier downsample (prefilter + Karis average), 0 = downsamples suivants
} pc;

#if defined(GL_EXT_shader_explicit_arithmetic_types_float16)
const f16vec3 kLumaWeights = f16vec3(float16_t(0.2126), float16_t(0.7152), float16_t(0.0722));

float16_t RGBToLuminance(f16vec3 color) {
    return dot(color, kLumaWeights);
}

f16vec3 ApplySoftKnee(f16vec3 color, float16_t threshold, float16_t knee) {
    float16_t brightness = dot(color, kLumaWeights);
    float16_t soft = brightness - threshold + knee;
    soft = clamp(soft, float16_t(0.0), float16_t(2.0) * knee);
    soft = (soft * soft) / (float16_t(4.0) * knee + float16_t(1e-4));
    float16_t contribution = max(soft, brightness - threshold) / max(brightness, float16_t(1e-4));
    return color * max(contribution, float16_t(0.0));
}

float16_t KarisWeight(f16vec3 color) {
    return float16_t(1.0) / (float16_t(1.0) + RGBToLuminance(color));
}
#else
float RGBToLuminance(vec3 color) {
    return dot(color, vec3(0.2126, 0.7152, 0.0722));
}

vec3 ApplySoftKnee(vec3 color, float threshold, float knee) {
    float brightness = dot(color, vec3(0.2126, 0.7152, 0.0722));
    float soft = brightness - threshold + knee;
    soft = clamp(soft, 0.0, 2.0 * knee);
    soft = (soft * soft) / (4.0 * knee + 0.00001);
    float contribution = max(soft, brightness - threshold) / max(brightness, 0.00001);
    return color * max(contribution, 0.0);
}

float KarisWeight(vec3 color) {
    return 1.0 / (1.0 + RGBToLuminance(color));
}
#endif

void main() {
    ivec2 destCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 destSize = imageSize(u_output_image);

    if (destCoord.x >= destSize.x || destCoord.y >= destSize.y) {
        return;
    }

    // Coordonnées UV au centre du texel de destination
    vec2 uv = (vec2(destCoord) + 0.5) / vec2(destSize);
    vec2 texel = pc.u_texel_size;

    // Kernel 13-Tap (Jimenez / Next Generation Post-Processing in Call of Duty)
    // Échantillons extérieurs (coins du rectangle 4x4)
    vec3 a_f32 = texture(u_input_texture, uv + vec2(-2.0 * texel.x, -2.0 * texel.y)).rgb;
    vec3 b_f32 = texture(u_input_texture, uv + vec2( 0.0,           -2.0 * texel.y)).rgb;
    vec3 c_f32 = texture(u_input_texture, uv + vec2( 2.0 * texel.x, -2.0 * texel.y)).rgb;

    vec3 d_f32 = texture(u_input_texture, uv + vec2(-2.0 * texel.x,  0.0)).rgb;
    vec3 e_f32 = texture(u_input_texture, uv).rgb;
    vec3 f_f32 = texture(u_input_texture, uv + vec2( 2.0 * texel.x,  0.0)).rgb;

    vec3 g_f32 = texture(u_input_texture, uv + vec2(-2.0 * texel.x,  2.0 * texel.y)).rgb;
    vec3 h_f32 = texture(u_input_texture, uv + vec2( 0.0,            2.0 * texel.y)).rgb;
    vec3 i_f32 = texture(u_input_texture, uv + vec2( 2.0 * texel.x,  2.0 * texel.y)).rgb;

    // Échantillons intérieurs (centres des 4 quadrants 2x2)
    vec3 j_f32 = texture(u_input_texture, uv + vec2(-1.0 * texel.x, -1.0 * texel.y)).rgb;
    vec3 k_f32 = texture(u_input_texture, uv + vec2( 1.0 * texel.x, -1.0 * texel.y)).rgb;
    vec3 l_f32 = texture(u_input_texture, uv + vec2(-1.0 * texel.x,  1.0 * texel.y)).rgb;
    vec3 m_f32 = texture(u_input_texture, uv + vec2( 1.0 * texel.x,  1.0 * texel.y)).rgb;

#if defined(GL_EXT_shader_explicit_arithmetic_types_float16)
    f16vec3 a = f16vec3(a_f32);
    f16vec3 b = f16vec3(b_f32);
    f16vec3 c = f16vec3(c_f32);
    f16vec3 d = f16vec3(d_f32);
    f16vec3 e = f16vec3(e_f32);
    f16vec3 f = f16vec3(f_f32);
    f16vec3 g = f16vec3(g_f32);
    f16vec3 h = f16vec3(h_f32);
    f16vec3 i = f16vec3(i_f32);
    f16vec3 j = f16vec3(j_f32);
    f16vec3 k = f16vec3(k_f32);
    f16vec3 l = f16vec3(l_f32);
    f16vec3 m = f16vec3(m_f32);

    f16vec3 result = f16vec3(float16_t(0.0));

    if (pc.u_is_prefilter != 0) {
        float16_t thresh = float16_t(pc.u_threshold);
        float16_t knee = float16_t(pc.u_knee);

        a = ApplySoftKnee(a, thresh, knee);
        b = ApplySoftKnee(b, thresh, knee);
        c = ApplySoftKnee(c, thresh, knee);
        d = ApplySoftKnee(d, thresh, knee);
        e = ApplySoftKnee(e, thresh, knee);
        f = ApplySoftKnee(f, thresh, knee);
        g = ApplySoftKnee(g, thresh, knee);
        h = ApplySoftKnee(h, thresh, knee);
        i = ApplySoftKnee(i, thresh, knee);
        j = ApplySoftKnee(j, thresh, knee);
        k = ApplySoftKnee(k, thresh, knee);
        l = ApplySoftKnee(l, thresh, knee);
        m = ApplySoftKnee(m, thresh, knee);

        f16vec3 g0 = (a + b + d + e) * float16_t(0.25);
        f16vec3 g1 = (b + c + e + f) * float16_t(0.25);
        f16vec3 g2 = (d + e + g + h) * float16_t(0.25);
        f16vec3 g3 = (e + f + h + i) * float16_t(0.25);
        f16vec3 g4 = (j + k + l + m) * float16_t(0.25);

        float16_t w0 = KarisWeight(g0);
        float16_t w1 = KarisWeight(g1);
        float16_t w2 = KarisWeight(g2);
        float16_t w3 = KarisWeight(g3);
        float16_t w4 = KarisWeight(g4);

        float16_t totalWeight = w0 + w1 + w2 + w3 + w4;
        if (totalWeight > float16_t(1e-4)) {
            result = (g0 * w0 + g1 * w1 + g2 * w2 + g3 * w3 + g4 * w4) / totalWeight;
        } else {
            result = g4;
        }
    } else {
        result = e * float16_t(0.125);
        result += (a + c + g + i) * float16_t(0.03125);
        result += (b + d + f + h) * float16_t(0.0625);
        result += (j + k + l + m) * float16_t(0.125);
    }

    result = max(result, f16vec3(float16_t(0.0)));
    result = min(result, f16vec3(float16_t(65504.0)));
    imageStore(u_output_image, destCoord, vec4(vec3(result), 1.0));
#else
    vec3 a = a_f32; vec3 b = b_f32; vec3 c = c_f32;
    vec3 d = d_f32; vec3 e = e_f32; vec3 f = f_f32;
    vec3 g = g_f32; vec3 h = h_f32; vec3 i = i_f32;
    vec3 j = j_f32; vec3 k = k_f32; vec3 l = l_f32; vec3 m = m_f32;

    vec3 result = vec3(0.0);
    if (pc.u_is_prefilter != 0) {
        a = ApplySoftKnee(a, pc.u_threshold, pc.u_knee);
        b = ApplySoftKnee(b, pc.u_threshold, pc.u_knee);
        c = ApplySoftKnee(c, pc.u_threshold, pc.u_knee);
        d = ApplySoftKnee(d, pc.u_threshold, pc.u_knee);
        e = ApplySoftKnee(e, pc.u_threshold, pc.u_knee);
        f = ApplySoftKnee(f, pc.u_threshold, pc.u_knee);
        g = ApplySoftKnee(g, pc.u_threshold, pc.u_knee);
        h = ApplySoftKnee(h, pc.u_threshold, pc.u_knee);
        i = ApplySoftKnee(i, pc.u_threshold, pc.u_knee);
        j = ApplySoftKnee(j, pc.u_threshold, pc.u_knee);
        k = ApplySoftKnee(k, pc.u_threshold, pc.u_knee);
        l = ApplySoftKnee(l, pc.u_threshold, pc.u_knee);
        m = ApplySoftKnee(m, pc.u_threshold, pc.u_knee);

        vec3 g0 = (a + b + d + e) * 0.25;
        vec3 g1 = (b + c + e + f) * 0.25;
        vec3 g2 = (d + e + g + h) * 0.25;
        vec3 g3 = (e + f + h + i) * 0.25;
        vec3 g4 = (j + k + l + m) * 0.25;

        float w0 = KarisWeight(g0);
        float w1 = KarisWeight(g1);
        float w2 = KarisWeight(g2);
        float w3 = KarisWeight(g3);
        float w4 = KarisWeight(g4);

        float totalWeight = w0 + w1 + w2 + w3 + w4;
        if (totalWeight > 1e-5) {
            result = (g0 * w0 + g1 * w1 + g2 * w2 + g3 * w3 + g4 * w4) / totalWeight;
        } else {
            result = g4;
        }
    } else {
        result = e * 0.125;
        result += (a + c + g + i) * 0.03125;
        result += (b + d + f + h) * 0.0625;
        result += (j + k + l + m) * 0.125;
    }

    result = max(result, vec3(0.0));
    result = min(result, vec3(65504.0));
    imageStore(u_output_image, destCoord, vec4(result, 1.0));
#endif
}
